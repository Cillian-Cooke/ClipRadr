YOUTUBE_API_KEY=
# Optional on Vercel: Neon/Postgres URL so creators survive cold starts
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./data/clipradar.db
OPENAI_API_KEY=
STORAGE_PATH=./media
DEMO_MODE=false

# Pipeline
AUTO_SCAN_ON_ADD=true
MAX_COMMENTS_PER_VIDEO=1000
RECENT_VIDEOS_LIMIT=20
CLUSTER_WINDOW_SECONDS=10
CLUSTER_RADIUS_SECONDS=5
MAX_CLUSTER_SPAN_SECONDS=15
PRE_ROLL_SECONDS=10
POST_ROLL_SECONDS=10
SIMILARITY_THRESHOLD=0.78

# Vercel: set YOUTUBE_API_KEY (+ optional DATABASE_URL) in project Environment Variables.
# Browser cache restores followed channels if the server DB was wiped.
