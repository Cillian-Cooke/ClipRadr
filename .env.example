YOUTUBE_API_KEY=

# Local development (default)
DATABASE_URL=sqlite:///./data/clipradar.db

# Required on Vercel — Neon pooled connection string (Settings → Connection details → Pooled)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

OPENAI_API_KEY=
STORAGE_PATH=./media
DEMO_MODE=false

# Pipeline
AUTO_SCAN_ON_ADD=true
MAX_COMMENTS_PER_VIDEO=1000
RECENT_VIDEOS_LIMIT=20
CLUSTER_WINDOW_SECONDS=10
CLUSTER_RADIUS_SECONDS=5
MAX_CLUSTER_SPAN_SECONDS=15
PRE_ROLL_SECONDS=10
POST_ROLL_SECONDS=10
SIMILARITY_THRESHOLD=0.78

# Vercel Environment Variables (Production):
#   YOUTUBE_API_KEY=...
#   DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
#   DEMO_MODE=false
# Then Redeploy. Without DATABASE_URL, creators disappear on every cold start.
