YOUTUBE_API_KEY=

# Local development (default)
DATABASE_URL=sqlite:///./data/clipradr.db

# Required on Vercel — Neon pooled connection string (Settings → Connection details → Pooled)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

OPENAI_API_KEY=
STORAGE_PATH=./media
DEMO_MODE=false

# Pipeline
AUTO_SCAN_ON_ADD=true
MAX_COMMENTS_PER_VIDEO=1000
RECENT_VIDEOS_LIMIT=20
CLUSTER_WINDOW_SECONDS=10
CLUSTER_RADIUS_SECONDS=5
MAX_CLUSTER_SPAN_SECONDS=15
PRE_ROLL_SECONDS=10
POST_ROLL_SECONDS=10
SIMILARITY_THRESHOLD=0.78
FREE_EXPORTS_PER_DAY=3

# Firebase Auth + Firestore (plug in when you have credentials)
# Service account JSON path (preferred) OR paste JSON into FIREBASE_CREDENTIALS_JSON
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Local-only: set true to skip Firebase login. Always false on Railway.
DEV_AUTH_BYPASS=false

# Vercel Environment Variables (Production):
#   YOUTUBE_API_KEY=...
#   DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
#   DEMO_MODE=false
#   FIREBASE_* as above
# Then Redeploy. Without DATABASE_URL, creators disappear on every cold start.
# Clip MP4 export (yt-dlp) — Railway needs cookies as ONE LINE base64:
#   base64 -w0 secrets/youtube-cookies.txt
# Then Railway Variable: YTDLP_COOKIES_B64=<that output>
# (Raw YTDLP_COOKIES paste often corrupts tabs — prefer B64.)
# YTDLP_COOKIES_PATH=./secrets/youtube-cookies.txt
# YTDLP_COOKIES_B64=
# YTDLP_COOKIES=
